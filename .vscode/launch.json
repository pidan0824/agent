{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv-memory/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/.runtime",
        "PYTHONUNBUFFERED": "1",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "TOKENIZERS_PARALLELISM": "false"
      },
      "name": "01 真实数据 + Qwen：Seller → Customer 单步",
      "module": "agent_simulation.simulation.run",
      "args": [
        "--catalog",
        "${workspaceFolder}/data/kuaisearch/lite/source/catalog",
        "--model",
        "${workspaceFolder}/models/Qwen2.5-3B-Instruct",
        "--output",
        "${workspaceFolder}/runs/debug/${input:runName}",
        "--seller",
        "319675",
        "--customers",
        "83860",
        "--cutoff",
        "850769",
        "--mode",
        "episode",
        "--ticks",
        "1",
        "--tick-size",
        "1",
        "--top-k",
        "3",
        "--candidate-size",
        "3",
        "--search-backend",
        "random",
        "--history-retrieval",
        "bge",
        "--seed",
        "42",
        "--max-concurrent-requests",
        "1",
        "--seller-price-batch-size",
        "1",
        "--customer-response-batch-size",
        "64",
        "--max-new-tokens",
        "1024",
        "--request-timeout",
        "86400",
        "--device",
        "mps",
        "--dtype",
        "float16"
      ]
    },
    {
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv-memory/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/.runtime",
        "PYTHONUNBUFFERED": "1",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "TOKENIZERS_PARALLELISM": "false"
      },
      "name": "02 局部回归：阶段、快照与并发（测试模型）",
      "module": "unittest",
      "args": [
        "-v",
        "agent_simulation.tests.simulation.test_episode.EpisodeTests.test_phase_barriers_and_next_tick_context",
        "agent_simulation.tests.agents.test_customer_parallel.CustomerParallelTests.test_next_batch_starts_while_first_batch_is_still_running",
        "agent_simulation.tests.environment.test_state_revision.StateRevisionTests.test_staged_review_rejects_change_then_restore_before_state_read"
      ]
    }
  ],
  "inputs": [
    {
      "id": "runName",
      "type": "promptString",
      "description": "本次调试的新目录名（如 manual-001；每次使用新名字，已有目录会拒绝覆盖）",
      "default": "manual-001"
    }
  ]
}
